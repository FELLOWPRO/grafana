    {
      "id": 9,
      "title": "p95 Requestdauer – mindestens 200 Beobachtungen / 5 min",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "description": "Histogrammschätzung; keine belastbaren Quantile aus alten Worker-Messungen.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95,sum by(endpoint,le)(rate(docbits_request_duration_seconds_bucket{namespace=\"$environment\",job=\"api-service\"}[5m]))) and on(endpoint) (sum by(endpoint)(increase(docbits_request_duration_seconds_count{namespace=\"$environment\",job=\"api-service\"}[5m])) >= 200)) and on() ((min(docbits_api_metrics_multiprocess_enabled{namespace=\"$environment\",job=\"api-service\"}) == 1) and (count(docbits_api_metrics_multiprocess_enabled{namespace=\"$environment\",job=\"api-service\"}) == count(up{namespace=\"$environment\",job=\"api-service\"} == 1)) unless (count(docbits_request_duration_seconds_count{namespace=\"$environment\",job=\"api-service\"} != ignoring(le) docbits_request_duration_seconds_bucket{namespace=\"$environment\",job=\"api-service\",le=\"+Inf\"}) > 0))",
