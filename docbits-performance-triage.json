      "title": "Endpunkte: Requests über 1 s in 5 min",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 6
      },
      "description": "Geschätzte Häufigkeiten aus Counter-Zuwächsen. Nur bei freigegebener Messung; 3-s-Bucket benötigt neue API-Version.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
