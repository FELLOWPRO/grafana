      "title": "Automatischer Hinweis: anhaltend langsame Endpunkte",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 83,
        "w": 24,
        "h": 6
      },
      "description": "Hinweis bei mehr als 5% Requests über 1 s in 5 min und mindestens 200 Beobachtungen. Kein Ursachenbeweis.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by(endpoint)(increase(docbits_request_duration_seconds_count{namespace=\"$environment\",job=\"api-service\"}[5m])) - sum by(endpoint)(increase(docbits_request_duration_seconds_bucket{namespace=\"$environment\",job=\"api-service\",le=\"1.0\"}[5m]))) / sum by(endpoint)(increase(docbits_request_duration_seconds_count{namespace=\"$environment\",job=\"api-service\"}[5m])) > 0.05 and on(endpoint) (sum by(endpoint)(increase(docbits_request_duration_seconds_count{namespace=\"$environment\",job=\"api-service\"}[5m])) >= 200)) and on() ((min(docbits_api_metrics_multiprocess_enabled{namespace=\"$environment\",job=\"api-service\"}) == 1) and (count(docbits_api_metrics_multiprocess_enabled{namespace=\"$environment\",job=\"api-service\"}) == count(up{namespace=\"$environment\",job=\"api-service\"} == 1)) unless (count(docbits_request_duration_seconds_count{namespace=\"$environment\",job=\"api-service\"} != ignoring(le) docbits_request_duration_seconds_bucket{namespace=\"$environment\",job=\"api-service\",le=\"+Inf\"}) > 0))",
          "legendFormat": "{{endpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
