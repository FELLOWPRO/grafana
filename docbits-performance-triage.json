    {
      "id": 11,
      "title": "Wo wartet es? Gemessene Phasen",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "description": "Durchschnitt nur für Requests mit erfasster Komponente. Fehlende Auth/Pool/Upstream-Phasen bleiben ungemessen. Keine additive Zerlegung.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(endpoint,component)(rate(docbits_request_component_duration_seconds_sum{namespace=\"$environment\",job=\"api-service\"}[5m])) / sum by(endpoint,component)(rate(docbits_request_component_duration_seconds_count{namespace=\"$environment\",job=\"api-service\"}[5m]))) and on() ((min(docbits_api_metrics_multiprocess_enabled{namespace=\"$environment\",job=\"api-service\"}) == 1) and (count(docbits_api_metrics_multiprocess_enabled{namespace=\"$environment\",job=\"api-service\"}) == count(up{namespace=\"$environment\",job=\"api-service\"} == 1)) unless (count(docbits_request_duration_seconds_count{namespace=\"$environment\",job=\"api-service\"} != ignoring(le) docbits_request_duration_seconds_bucket{namespace=\"$environment\",job=\"api-service\",le=\"+Inf\"}) > 0))",
          "legendFormat": "{{endpoint}} · {{component}}",
