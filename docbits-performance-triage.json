          "legendFormat": "langsame Requests",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Messung fehlt / noch nicht freigegeben"
        },
        "overrides": []
